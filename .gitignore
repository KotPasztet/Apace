/mce.apk
/mce.ipa
/mce-decoded/
# Persona catalog fetch/generation scratch data (scripts/fetch_persona_catalog.py)
work/

# Mojang-owned persona piece binaries and dressing room thumbnails are no longer
# shipped in the repo — the runtime Mojang asset gate downloads them into the
# persistent data dir (<data>/mojang-assets/{playfab/persona,images}) and the
# CDN controllers serve them from there. Only Apace-authored files below.
staticdata-extras/playfab/persona/*
