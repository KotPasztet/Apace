@page "/Admin/LinkedAccounts"
@* Linked accounts moved into the Manage Users page as its "Linked accounts" tab.
   This route only survives as a redirect so old links keep working. *@
@using Microsoft.AspNetCore.Authorization
@using Solace.LauncherUI.Utils
@attribute [Authorize(Policy = Permissions.LinkPlayers)]
@rendermode InteractiveServer
@inject NavigationManager NavigationManager

<PageTitle>Linked Accounts - Apace</PageTitle>

@code {
    protected override void OnInitialized()
    {
        NavigationManager.NavigateTo("/Admin/Users?tab=linked");
    }
}
