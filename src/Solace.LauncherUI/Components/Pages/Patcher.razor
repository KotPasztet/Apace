            ChangePlayfabApiAddress = changePlayfab,
            PlayfabApiProtocol = playfabProtocol,
            PlayfabApiHostname = playfabHostname,
            ChangeXboxAbAddress = changeXboxAb,
            XboxAbProtocol = xboxAbProtocol,
