    private void ViewJob(string jobId)
    {
        activeJobId = jobId;
        logSnapshot = PatcherService.GetJob(jobId)?.GetLogSnapshot() ?? [];
    }

    private void CloseJobView()
    {
        activeJobId = null;
        logSnapshot = [];
        RemoveUploadedFile();
    }

    private string JobBadgeClass(PatchJob job)
        => job.Status switch
        {
            PatchJobStatus.Succeeded => "bg-success",
            PatchJobStatus.Failed => "bg-danger",
            PatchJobStatus.Running => "bg-primary",
            _ => "bg-secondary",
        };

    private static string FormatBytes(long bytes)
        => bytes >= 1024 * 1024 * 1024 ? $"{bytes / (double)(1024 * 1024 * 1024):F2} GB"
           : bytes >= 1024 * 1024 ? $"{bytes / (double)(1024 * 1024):F1} MB"
           : $"{bytes / 1024.0:F0} KB";

    private void ShowDialog(bool success, string message)
    {
        isSuccess = success;
        dialogMessage = message;
        showDialog = true;
    }

    private void CloseDialog()
    {
        showDialog = false;
    }

    public void Dispose()
    {
        pollTimer?.Dispose();
        uploadCts?.Cancel();
        uploadCts?.Dispose();

        // orphaned uploads (never turned into a job) should not linger on disk
        if (uploadedPath is not null)
        {
            TryDelete(uploadedPath);
        }
    }
}

