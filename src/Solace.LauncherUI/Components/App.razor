<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Launcher.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
    <script>
        (function() {
            var toggling = false;
            function applyDark() {
                var html = document.documentElement;
                if (localStorage.getItem('darkMode') === 'true') html.classList.add('dark');
                else html.classList.remove('dark');
            }
            applyDark();
            window.toggleDarkMode = function() {
                toggling = true;
                var html = document.documentElement;
                var isDark = html.classList.toggle('dark');
                localStorage.setItem('darkMode', isDark);
                setTimeout(function() { toggling = false; }, 100);
            };
            new MutationObserver(function() {
                if (toggling) return;
                if (localStorage.getItem('darkMode') === 'true' && !document.documentElement.classList.contains('dark'))
                    document.documentElement.classList.add('dark');
            }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
        })();
    </script>
    <script>
        // Patcher uploads: sends the selected APK/IPA straight to /api/patcher/upload over
        // plain HTTP. Bypasses the Blazor Server circuit, whose file streaming is capped at
        // ~50 KB per SignalR message (RemoteJSDataStream), making large uploads crawl.
        (function() {
            var activeXhr = null;
            window.apacePatcher = {
                upload: function(dropZoneId, url, headers, progressMethod, dotnetRef) {
                    return new Promise(function(resolve, reject) {
                        var zone = document.getElementById(dropZoneId);
                        var input = zone && zone.querySelector('input[type="file"]');
                        var file = input && input.files && input.files[0];

                        if (!file) { reject('UPLOAD_ABORTED: no file selected'); return; }

                        var xhr = new XMLHttpRequest();
                        activeXhr = xhr;
                        xhr.open('POST', url, true);

                        for (var key in headers) xhr.setRequestHeader(key, headers[key]);

                        var lastProgress = 0;
                        xhr.upload.onprogress = function(e) {
                            var now = Date.now();
                            if (e.loaded === e.total || now - lastProgress >= 100) {
                                lastProgress = now;
                                dotnetRef.invokeMethodAsync(progressMethod, e.loaded, e.total);
                            }
                        };
                        xhr.onload = function() {
                            activeXhr = null;
                            if (xhr.status >= 200 && xhr.status < 300) resolve(xhr.responseText);
                            else reject('Upload failed (HTTP ' + xhr.status + ').');
                        };
                        xhr.onerror = function() { activeXhr = null; reject('Upload failed - network error.'); };
                        xhr.onabort = function() { activeXhr = null; reject('UPLOAD_ABORTED: cancelled'); };

                        xhr.send(file);
                    });
                },
                cancel: function() {
                    if (activeXhr) activeXhr.abort();
                }
            };
        })();
    </script>
</body>

</html>
