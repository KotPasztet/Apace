@page "/ServerStatus"
@rendermode InteractiveServer
@using System.Security.Claims
@using Serilog
@using Apace.LauncherUI.Utils
@inject AuthenticationStateProvider AuthStateProvider
@inject LogsLogService LogService
@inject ServerManager ServerManager
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Server Status - Apace</PageTitle>

<script>
    window.initLogScroller = (container) => {
        if (!container) return;

        container.scrollTop = container.scrollHeight;

        let isScrolledToBottom = true;

        container.addEventListener('scroll', () => {
            isScrolledToBottom = container.scrollHeight - container.scrollTop <= container.clientHeight + 10;
        });

        const observer = new MutationObserver(() => {
            if (isScrolledToBottom) {
                container.scrollTop = container.scrollHeight;
            }
        });

        observer.observe(container, { childList: true, subtree: true });
    };

    // Copies text to the BROWSER's clipboard (the panel client's clipboard,
    // not the server's). navigator.clipboard needs a user gesture + secure
    // context; from a Blazor Server round-trip the activation window usually
    // still holds in Chromium, but a textarea + execCommand fallback keeps it
    // working when the promise rejects (e.g. Firefox, or a slow circuit).
    window.copyLogsToClipboard = (text) => {
        const fallback = () => {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.focus();
            ta.select();
            try {
                document.execCommand('copy');
            } finally {
                document.body.removeChild(ta);
            }
        };

        if (navigator.clipboard && navigator.clipboard.writeText) {
            return navigator.clipboard.writeText(text).catch(fallback);
        }
        fallback();
        return Promise.resolve();
    };
</script>

<div class="card mb-4">
    <div class="card-body text-center">
        <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.7rem; letter-spacing: 2px;">System Status</h6>
        <div class="d-flex align-items-center justify-content-center mt-2">
            <div class="status-dot @GetStatusClass(_currentStatus) mr-2"></div>
            <h2 class="display-4 mb-0" style="font-size: 1.8rem; border-bottom: none; padding-bottom: 0;">@_currentStatus.ToString().ToUpper()</h2>
        </div>
        <small class="text-muted mt-3 d-block">Last updated: @FormatCurrentTime()</small>
    </div>
</div>

@if (_eulaPending)
{
    <div class="alert alert-warning">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <strong>Mojang EULA must be accepted</strong><br />
                <small>The Minecraft server requires you to accept the End User License Agreement.</small>
            </div>
            <button class="btn btn-warning btn-sm" @onclick="AcceptEula">
                ✓ Accept EULA
            </button>
        </div>
    </div>
}

@if (_resourcePackPending)
{
    <div class="alert alert-warning">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <strong>Resource pack missing</strong><br />
                <small>The vanilla resource pack (<code>staticdata/resourcepacks/vanilla.zip</code>) is required before the server can start. Starting the server will ask you to confirm the download; after it finishes, press Start again.</small>
                @if (!string.IsNullOrEmpty(_resourcePackError))
                {
                    <br />
                    <small class="text-danger">@_resourcePackError</small>
                }
            </div>
            <div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="resourcePackRights" @bind="_resourcePackRightsConfirmed" />
                    <label class="form-check-label" for="resourcePackRights">
                        I confirm I own a licensed copy of Minecraft: Earth / Bedrock and accept the applicable Terms
                    </label>
                </div>
                <button class="btn btn-warning btn-sm" @onclick="DownloadResourcePack"
                        disabled="@(IsButtonDisabled(Permissions.EditServerOptions) || !_resourcePackRightsConfirmed || _downloadingResourcePack)">
                    ↓ Download resource pack
                </button>
                <button type="button" class="btn btn-link btn-sm" @onclick="DismissResourcePack" disabled="@_downloadingResourcePack">
                    Not now
                </button>
            </div>
        </div>
    </div>
}

@if (_downloadingResourcePack || _resourcePackDownloadRunning)
{
    <div class="alert alert-warning">
        <div class="progress" style="height: 8px;">
            <div class="progress-bar progress-bar-striped progress-bar-animated"
                 style="width: @(_resourcePackDownloadProgress * 100)%"></div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-1">
            <small class="text-muted">@(_downloadingResourcePack ? "Downloading resource pack" : "Waiting for the resource pack download")... @((_resourcePackDownloadProgress * 100).ToString("F0"))%</small>
            <button type="button" class="btn btn-link btn-sm p-0" @onclick="CancelResourcePackDownload">Cancel</button>
        </div>
    </div>
}

@if (_resourcePackDownloadJustFinished)
{
    <div class="alert alert-success">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <strong>Resource pack downloaded — press Start again to boot the server.</strong>
            </div>
            <button type="button" class="btn btn-link btn-sm" @onclick="DismissResourcePackDownloadBanner">Not now</button>
        </div>
    </div>
}

<div class="section-title">Components</div>
<div class="comp-grid mb-4">
    @foreach (var comp in ServerManager.Components)
    {
        <div class="comp-card">
            <div class="comp-info">
                <div class="status-dot @GetStatusClass(comp.Status)"></div>
                <div>
                    <div class="comp-name">@comp.Name</div>
                    <div class="comp-status">@comp.Status.ToString()</div>
                </div>
            </div>

            @if (comp.Status is LauncherUI.ServerStatus.Offline)
            {
                <button class="btn btn-success btn-sm" style="width: 34px; height: 34px; padding: 0; justify-content: center;"
                        title="Start Component"
                        disabled="@(IsButtonDisabled(Permissions.StartServer) || !ServerManager.CanStart || _currentStatus is LauncherUI.ServerStatus.Starting or LauncherUI.ServerStatus.Stopping)"
                        @onclick="() => StartComponent(comp.ExeName)">
                    ▶
                </button>
            }
        </div>
    }

    <div class="comp-card">
        <div class="comp-info">
            <div class="status-dot @(_javaServerOnline ? "status-online" : _javaServerStarting ? "status-starting" : "status-offline")"></div>
            <div>
                <div class="comp-name">Java Server</div>
                <div class="comp-status">@(_javaServerOnline ? "Online" : _javaServerStarting ? "Starting" : "Offline")</div>
            </div>
        </div>
    </div>
</div>

@if (!IsButtonDisabled(Permissions.StartServer) || !IsButtonDisabled(Permissions.RestartServer) ||
    !IsButtonDisabled(Permissions.StopServer))
{
    <div class="section-title mt-4">Controls</div>
    <div class="row gap-2 mb-4">
        <div class="col">
            <button class="btn btn-success btn-lg w-100 d-flex flex-column align-items-center justify-content-center"
                    disabled="@(IsButtonDisabled(Permissions.StartServer) || !ServerManager.CanStart)"
                    @onclick="() => StartServer()">
                <span style="font-size: 1.5rem;">▶</span>
                <span style="font-size: 0.8rem;">Start All</span>
            </button>
        </div>
        <div class="col">
            <button class="btn btn-warning btn-lg w-100 d-flex flex-column align-items-center justify-content-center"
                    disabled="@(IsButtonDisabled(Permissions.RestartServer) || !ServerManager.CanRestart)"
                    @onclick="() => RestartServer()">
                <span style="font-size: 1.5rem; font-weight: 900; line-height: 1;">↺</span>
                <span style="font-size: 0.8rem; font-weight: 700;">Restart</span>
            </button>
        </div>
        <div class="col">
            <button class="btn btn-danger btn-lg w-100 d-flex flex-column align-items-center justify-content-center"
                    disabled="@(IsButtonDisabled(Permissions.StopServer) || !ServerManager.CanStop)"
                    @onclick="() => StopServer()">
                <span style="font-size: 1.5rem;">■</span>
                <span style="font-size: 0.8rem;">Stop</span>
            </button>
        </div>
        <div class="col-12 mt-2">
            <button class="btn btn-danger btn-lg w-100 d-flex flex-column align-items-center justify-content-center"
                    disabled="@IsButtonDisabled(Permissions.StopServer)" @onclick="() => KillAll()">
                <span style="font-size: 1.5rem; font-weight: 900;">✕</span>
                <span style="font-size: 0.8rem; font-weight: bold;">KILL ALL PROCESSES</span>
            </button>
        </div>
    </div>
}

@if (_showNoPacksPopup)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="background: rgba(0,0,0,.55); z-index: 2000;">
        <div class="card shadow" style="max-width: 30rem; width: calc(100% - 2rem);">
            <div class="card-header fw-bold">No packs enabled</div>
            <div class="card-body">
                <p class="mb-0">No skin packs or bundles are selected. Select some in Marketplace Management.</p>
            </div>
            <div class="card-footer d-flex flex-wrap gap-2 justify-content-end">
                <button class="btn btn-primary btn-sm" @onclick="GoToMarketplace">Take me there</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="SuppressNoPacksPopupAndStart">Never show again</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="CloseNoPacksPopupAndStart">Close</button>
            </div>
        </div>
    </div>
}

@if (_showMapKeyPopup)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="background: rgba(0,0,0,.55); z-index: 2000;">
        <div class="card shadow" style="max-width: 30rem; width: calc(100% - 2rem);">
            <div class="card-header fw-bold">No map provider key</div>
            <div class="card-body">
                <p class="mb-0">@MapKeyPopupBody</p>
            </div>
            <div class="card-footer d-flex flex-wrap gap-2 justify-content-end">
                <button class="btn btn-primary btn-sm" @onclick="GoToMapOptions">Take me there</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="StartAnywayWithMapKey">Start anyway</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="NeverShowMapKeyPopupAgainAndStart">Never show again</button>
            </div>
        </div>
    </div>
}

@if (_showResourcePackConsent)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="background: rgba(0,0,0,.55); z-index: 2000;">
        <div class="card shadow" style="max-width: 30rem; width: calc(100% - 2rem);">
            <div class="card-header fw-bold">Resource pack required</div>
            <div class="card-body">
                <p class="mb-2">The server needs the vanilla resource pack (<code>staticdata/resourcepacks/vanilla.zip</code>, ~131 MB, one-time download) before it can start. After the download finishes, press Start again to boot the server.</p>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="resourcePackConsentRights" @bind="_popupRightsConfirmed" />
                    <label class="form-check-label" for="resourcePackConsentRights">
                        I confirm I own a licensed copy of Minecraft: Earth / Bedrock and accept the applicable Terms
                    </label>
                </div>
            </div>
            <div class="card-footer d-flex flex-wrap gap-2 justify-content-end">
                <button class="btn btn-primary btn-sm" @onclick="ConfirmResourcePackConsent" disabled="@(!_popupRightsConfirmed)">Confirm &amp; download</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="CancelResourcePackConsent">Cancel</button>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header">▸ Live Logs</div>
    <div class="card-body">
        @if (HasPermission(Permissions.ViewServerLogs))
        {
            <div class="nav-pills mb-2" style="overflow-x: auto;">
                @foreach (var component in LogService.GetKnownComponents())
                {
                    <button class="@(_activeTab == component ? "active" : "")"
                            @onclick="() => _activeTab = component">
                        @component
                    </button>
                }
            </div>

            <div class="log-filter mb-3 align-items-center flex-wrap gap-2">
                <span class="log-filter-label">Levels:</span>
                @foreach (var level in _allLevels)
                {
                    var isSelected = _selectedLevels.Contains(level);
                    <button class="@GetLogLevelClass(level) @(isSelected ? "" : "off")"
                            title="Show/hide @level entries"
                            @onclick="() => ToggleLogLevel(level)">
                        @(isSelected ? "✓ " : "")@GetShortLevel(level)
                    </button>
                }

                <button class="btn btn-secondary btn-sm ms-auto"
                        title="Copy every visible log line of the @(_activeTab) tab to this device's clipboard"
                        @onclick="CopyAllLogs" disabled="@_isCopyingLogs">
                    @(_isCopyingLogs ? "Copying…" : "⧉ Copy All")
                </button>
                @if (!string.IsNullOrEmpty(_copyLogsStatus))
                {
                    <span class="text-muted" style="font-size: 0.75rem;">@_copyLogsStatus</span>
                }
            </div>

            <div class="log-terminal" @ref="_logContainerRef">
                <div class="log-content">
                    @foreach (var log in LogService.GetLogsFor(_activeTab).Where(log => string.IsNullOrEmpty(log.Level) || _selectedLevels.Contains(log.Level)))
                    {
                        <div class="log-line"><span class="log-time">[@FormatTimestamp(log.Timestamp)]</span> <span class="log-level @GetLogLevelClass(log.Level)">[@GetShortLevel(log.Level)]</span> <span class="log-msg">@log.RenderedMessage</span></div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-light text-center py-4">
                <span style="font-size: 1.5rem;" class="d-block mb-2">🔒</span>
                <span class="text-muted">Log access restricted</span>
            </div>
        }
    </div>
</div>

@code {
    // The system stays in Starting until the Fabric server is fully booted —
    // both while the java process is loading AND in the window after the
    // launcher components report Online but before the java process has even
    // been spawned (otherwise the status flickers Online → Starting).
    // Offline/Stopping pass through unchanged.
    private Apace.LauncherUI.ServerStatus _currentStatus => !_javaServerOnline && ServerManager.Status is LauncherUI.ServerStatus.Online or LauncherUI.ServerStatus.PartiallyOnline
        ? LauncherUI.ServerStatus.Starting
        : ServerManager.Status;

    private string _activeTab = "Launcher";
    private readonly string[] _allLevels = { "Verbose", "Debug", "Information", "Warning", "Error", "Fatal" };

    // Debug starts hidden (the old 🐛 toggle hid exactly this level).
    private readonly HashSet<string> _selectedLevels = new(StringComparer.OrdinalIgnoreCase)
    {
        "Verbose", "Information", "Warning", "Error", "Fatal"
    };

    private ClaimsPrincipal? _user;
    private ElementReference _logContainerRef;
    private bool _scrollerInitialized;
    private bool _eulaPending;
    private bool _resourcePackPending;
    private bool _resourcePackRightsConfirmed;
    private bool _downloadingResourcePack;
    private bool _showNoPacksPopup;
    private float _resourcePackDownloadProgress;
    private string? _resourcePackError;
    private bool _javaServerOnline;
    private bool _javaServerStarting;
    private Timer? _eulaCheckTimer;
    private Timer? _statusRefreshTimer;
    private TimeZoneInfo? _userTimeZone;

    // True while ANY resource pack download is running — the panel's Download
    // button, the start flow's automatic download, or another browser tab.
    // Synced from FileChecker by the 2 s poll below so the shared progress
    // bar animates no matter who started the download.
    private bool _resourcePackDownloadRunning;

    // "No map provider key" popup (mirrors the no-packs popup): set when a
    // start action was requested but the tile renderer would crash on start
    // because the selected provider's credential is missing. The pending
    // action runs on "Start anyway" / "Never show again".
    private bool _showMapKeyPopup;
    private Func<Task>? _pendingMapKeyStartAction;

    // Resource pack consent popup (outer start guard): set when a start was
    // requested while the pack is missing and not downloading — it asks for
    // the rights confirmation before anything is fetched. The pending action
    // is stored but intentionally NEVER invoked: starting always requires a
    // fresh, deliberate Start click after the pack is in place.
    private bool _showResourcePackConsent;
    private bool _popupRightsConfirmed;
    private Func<Task>? _pendingConsentStartAction;

    // "Resource pack downloaded" success banner (two-phase start: download,
    // then the user presses Start again). Cleared by a real start attempt,
    // the dismiss link, or a new download; _prevDownloadRunning lets the 2 s
    // poll below detect the download's true→false transition.
    private bool _resourcePackDownloadJustFinished;
    private bool _prevDownloadRunning;

    protected override async Task OnInitializedAsync()
    {
        // Refresh before anything else (and before the auth lookup): the page
        // is prerendered, so the initial HTML would otherwise show Offline or
        // Starting until the refresh timer below fires for the first time.
        ServerManager.RefreshComponentStatuses();
        await RefreshJavaServerStatusAsync();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _user = authState.User;

        LogService.OnLogReceived += HandleUpdate;
        ServerManager.OnStatusChanged += HandleUpdate;

        // Poll EULA + resource pack prompt status every 2 seconds during server startup
        _eulaCheckTimer = new Timer(async _ =>
        {
            var pending = Apace.LauncherUI.FileChecker.EulaPending;

            // Any running resource pack download (panel button, start flow,
            // another tab) drives the same progress bar. The pack lands as a
            // .part file and only moves into place when complete, so freeze
            // the pending alert while a download is running instead of
            // re-stating the file mid-download.
            var downloadRunning = Apace.LauncherUI.FileChecker.IsResourcePackDownloading;

            // Download lifecycle: when a download just FINISHED (true→false),
            // either show the "press Start again" banner (pack valid) or
            // surface the failure — unless the manual Download button already
            // reported a more specific reason. When one STARTS (false→true),
            // clear the stale banner/error from a previous run.
            if (_prevDownloadRunning && !downloadRunning)
            {
                if (Apace.LauncherUI.FileChecker.ResourcePackValid)
                {
                    _resourcePackDownloadJustFinished = true;
                }
                else if (string.IsNullOrEmpty(_resourcePackError))
                {
                    _resourcePackError = "Resource pack download failed — see the Live Logs for details.";
                }
            }
            else if (!_prevDownloadRunning && downloadRunning)
            {
                _resourcePackDownloadJustFinished = false;
                _resourcePackError = null;
            }
            _prevDownloadRunning = downloadRunning;

            var downloadProgress = Apace.LauncherUI.FileChecker.ResourcePackDownloadProgress;
            var resourcePackPending = (_downloadingResourcePack || downloadRunning)
                ? _resourcePackPending
                : Apace.LauncherUI.FileChecker.ResourcePackPending;

            if (_eulaPending != pending || _resourcePackPending != resourcePackPending
                || _resourcePackDownloadRunning != downloadRunning
                || Math.Abs(_resourcePackDownloadProgress - downloadProgress) > 0.005f)
            {
                _eulaPending = pending;
                _resourcePackPending = resourcePackPending;
                _resourcePackDownloadRunning = downloadRunning;
                _resourcePackDownloadProgress = downloadProgress;
                await InvokeAsync(StateHasChanged);
            }
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(2));

        // Refresh component statuses every 3s (BuildplateLauncher Starting → Online)
        _statusRefreshTimer = new Timer(async _ =>
        {
            ServerManager.RefreshComponentStatuses();
            await RefreshJavaServerStatusAsync();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(3));
    }

    private async Task RefreshJavaServerStatusAsync()
    {
        // Readiness is latched in the ServerManager singleton (banner seen or
        // Fabric port reachable), not re-derived from the live log ring buffer:
        // the marker lines are evicted from that buffer during busy output and
        // it is empty after a LauncherUI restart.
        await ServerManager.RefreshJavaServerStatusAsync();

        _javaServerOnline = ServerManager.JavaServerRunning && ServerManager.JavaServerReady;
        _javaServerStarting = ServerManager.JavaServerRunning && !ServerManager.JavaServerReady;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The page is statically prerendered, so JS interop is only available
        // once the circuit exists — resolve the browser time zone here instead
        // of in OnInitializedAsync.
        if (firstRender && _userTimeZone is null)
        {
            _userTimeZone = await GetUserTimeZoneAsync();
            await InvokeAsync(StateHasChanged);
        }

        if (HasPermission(Permissions.ViewServerLogs) && !_scrollerInitialized)
        {
            await JS.InvokeVoidAsync("initLogScroller", _logContainerRef);
            _scrollerInitialized = true;
        }
    }

    private async Task<TimeZoneInfo> GetUserTimeZoneAsync()
    {
        var tzId = await JS.InvokeAsync<string>("eval", "Intl.DateTimeFormat().resolvedOptions().timeZone");
        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById(tzId);
        }
        catch
        {
            return TimeZoneInfo.Local;
        }
    }

    private string FormatTimestamp(DateTime utc)
        => _userTimeZone is null
            ? utc.ToString("HH:mm:ss")
            : TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), _userTimeZone).ToString("HH:mm:ss");

    // "Last updated" must show the *user's* wall-clock time, not the server's
    // (the container runs in UTC while the browser may be in any timezone).
    private string FormatCurrentTime()
        => _userTimeZone is null
            ? DateTime.Now.ToString("t")
            : TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, _userTimeZone).ToString("t");

    private async void HandleUpdate()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        LogService.OnLogReceived -= HandleUpdate;
        ServerManager.OnStatusChanged -= HandleUpdate;
        _eulaCheckTimer?.Dispose();
        _statusRefreshTimer?.Dispose();
    }

    private async Task StartServer()
    {
        // Nothing selected in the Marketplace Management pack picker (live
        // marketplace on): warn before starting — the offer would carry no
        // player-selected cosmetics. "Never show again" remembers the choice
        // and starts; "Take me there" opens the pack picker; "Close" just
        // dismisses (Start stays a conscious click).
        if ((Settings.Instance.LivePersonaCatalog ?? true)
            && Settings.Instance.PersonaDefaultPacks is not { Count: > 0 }
            && Settings.Instance.PersonaNoPacksPopupSuppressed != true)
        {
            _showNoPacksPopup = true;
            return;
        }

        await RunWithResourcePackConsent(() => RunWithMapKeyGuard(() => ServerManager.Start()));
    }

    private void GoToMarketplace()
    {
        _showNoPacksPopup = false;
        Navigation.NavigateTo("/Admin/PersonaPacks");
    }

    private async Task SuppressNoPacksPopupAndStart()
    {
        Settings.Instance.PersonaNoPacksPopupSuppressed = true;
        Settings.Instance.Save(Settings.DefaultPath);
        _showNoPacksPopup = false;
        await RunWithResourcePackConsent(() => RunWithMapKeyGuard(() => ServerManager.Start()));
    }

    private async Task CloseNoPacksPopupAndStart()
    {
        _showNoPacksPopup = false;
        await RunWithResourcePackConsent(() => RunWithMapKeyGuard(() => ServerManager.Start()));
    }

    // ── Resource pack consent guard (OUTER, wraps the map-key guard below) ──
    //
    // The pack is a hard start prerequisite and fetching ~131 MB needs the
    // user's explicit OK (rights confirmation). While the pack is missing and
    // not already downloading, every start parks here and shows the consent
    // popup; "Confirm & download" fetches the pack only — the server boots on
    // the NEXT Start click (two-phase start). With the pack valid, a download
    // already running, or the rights confirmed this session, the start runs
    // unchanged.
    private async Task RunWithResourcePackConsent(Func<Task> startAction)
    {
        if (!FileChecker.ResourcePackValid && !_resourcePackRightsConfirmed
            && !FileChecker.IsResourcePackDownloading)
        {
            // Kept only so Cancel/Confirm can drop it — intentionally never
            // invoked: starting always requires a fresh, deliberate Start click.
            _pendingConsentStartAction = startAction;
            _showResourcePackConsent = true;
            return;
        }

        _resourcePackDownloadJustFinished = false; // a real start attempt clears the banner
        await startAction();
    }

    // ── Map provider key guard (shared by every start entry point) ──
    //
    // When tile rendering is enabled and the selected tile data source's
    // credential is missing, the Tile Renderer would crash right after start
    // — so ask first. "Take me there" opens the map options tab (no start),
    // "Start anyway" dismisses and runs the pending start action, "Never show
    // again" remembers the choice and runs it.

    private async Task RunWithMapKeyGuard(Func<Task> startAction)
    {
        if (ShouldShowMapKeyPopup())
        {
            _pendingMapKeyStartAction = startAction;
            _showMapKeyPopup = true;
            return;
        }

        await startAction();
    }

    private static bool ShouldShowMapKeyPopup()
    {
        var settings = Settings.Instance;

        if (settings.MapKeyPopupSuppressed == true)
        {
            return false;
        }

        // Same condition the ServerManager uses to decide whether the Tile
        // Renderer component starts at all (null = enabled by default).
        if (settings.EnableTileRenderingLabel == false)
        {
            return false;
        }

        return (settings.TileDataSource ?? Settings.TileDataSourceE.MapTiler) switch
        {
            Settings.TileDataSourceE.MapTiler => string.IsNullOrWhiteSpace(settings.MapTilerApiKey),
            Settings.TileDataSourceE.PostgreSQL => string.IsNullOrWhiteSpace(settings.TileDatabaseConnectionString),
            _ => false,
        };
    }

    private string MapKeyPopupBody
        => (Settings.Instance.TileDataSource ?? Settings.TileDataSourceE.MapTiler) == Settings.TileDataSourceE.MapTiler
            ? "Map tiles need a MapTiler API key (free at maptiler.com). Without it the tile renderer will crash on start."
            : "Map tiles need a PostgreSQL tile database. Without a connection string the tile renderer will crash on start.";

    private void GoToMapOptions()
    {
        _showMapKeyPopup = false;
        _pendingMapKeyStartAction = null;
        Navigation.NavigateTo("/Admin/ServerOptions?tab=map");
    }

    private async Task StartAnywayWithMapKey()
    {
        _showMapKeyPopup = false;
        var startAction = _pendingMapKeyStartAction;
        _pendingMapKeyStartAction = null;
        if (startAction is not null)
        {
            await startAction();
        }
    }

    private async Task NeverShowMapKeyPopupAgainAndStart()
    {
        Settings.Instance.MapKeyPopupSuppressed = true;
        Settings.Instance.Save(Settings.DefaultPath);
        await StartAnywayWithMapKey();
    }

    private async Task StopServer()
        => await ServerManager.Stop();

    private async Task RestartServer()
        => await RunWithResourcePackConsent(() => RunWithMapKeyGuard(() => ServerManager.Restart()));

    private async Task KillAll()
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to force kill all server processes?");

        if (confirmed)
        {
            await ServerManager.KillAll();
        }
    }

    private void AcceptEula()
    {
        FileChecker.AcceptEula();
        _eulaPending = false;
    }

    private async Task DownloadResourcePack()
    {
        if (FileChecker.IsResourcePackDownloading)
        {
            _resourcePackError = "A resource pack download is already in progress — it may have been started from another browser tab.";
            return;
        }

        _downloadingResourcePack = true;
        _resourcePackDownloadProgress = 0;
        _resourcePackError = null;

        try
        {
            var result = await FileChecker.DownloadResourcePackAsync(new Progress<float>(progress =>
            {
                _resourcePackDownloadProgress = Math.Clamp(progress, 0f, 1f);
                InvokeAsync(StateHasChanged);
            }));

            // The download never throws — the outcome (and the reason for a
            // failure) is reported through the result. A success means a
            // fully downloaded, validated pack is in place; a failure means
            // the file is still missing/invalid and the reason is shown here.
            if (result.Success || !FileChecker.ResourcePackPending)
            {
                _resourcePackPending = false;
                _resourcePackRightsConfirmed = false;
                _resourcePackDownloadJustFinished = true;
            }
            else
            {
                _resourcePackError = result.Error ?? $"Download failed — '{FileChecker.ResourcePackPath}' is still missing or invalid. Try again later or add the file manually.";
            }
        }
        catch (Exception ex)
        {
            _resourcePackError = ex.Message;
        }
        finally
        {
            _downloadingResourcePack = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelResourcePackDownload()
        => FileChecker.CancelResourcePackDownload();

    private void DismissResourcePack()
    {
        FileChecker.DismissResourcePackPrompt();
        _resourcePackPending = false;
    }

    // Consent popup buttons: "Confirm & download" remembers the confirmation
    // and fetches the pack (never starts the server — two-phase start);
    // "Cancel" just dismisses and drops the parked start action.
    private async Task ConfirmResourcePackConsent()
    {
        _resourcePackRightsConfirmed = true;
        _popupRightsConfirmed = false;
        _showResourcePackConsent = false;
        _pendingConsentStartAction = null;
        await DownloadResourcePack();
    }

    private void CancelResourcePackConsent()
    {
        _showResourcePackConsent = false;
        _pendingConsentStartAction = null;
        _popupRightsConfirmed = false;
    }

    private void DismissResourcePackDownloadBanner()
        => _resourcePackDownloadJustFinished = false;

    private async Task StartComponent(string exeName)
        => await RunWithResourcePackConsent(() => RunWithMapKeyGuard(() => ServerManager.StartComponents(exeName)));

    private bool HasPermission(string permission)
        => _user?.HasPermission(permission) ?? false;

    private bool IsButtonDisabled(string permission)
        => !HasPermission(permission);

    private string GetStatusClass(Apace.LauncherUI.ServerStatus status)
        => status switch
        {
            Apace.LauncherUI.ServerStatus.Online => "status-online",
            Apace.LauncherUI.ServerStatus.PartiallyOnline => "status-online",
            Apace.LauncherUI.ServerStatus.Starting => "status-starting",
            Apace.LauncherUI.ServerStatus.Stopping => "status-stopping",
            _ => "status-offline"
        };

    private void ToggleLogLevel(string level)
    {
        if (_selectedLevels.Contains(level))
        {
            _selectedLevels.Remove(level);
        }
        else
        {
            _selectedLevels.Add(level);
        }
    }

    // "Copy All" for the live log panel: puts every visible line of the
    // ACTIVE tab (Launcher / ApiServer / …, respecting the level filter) on
    // the BROWSER's clipboard via JS interop — never the server's clipboard.
    private bool _isCopyingLogs = false;
    private string? _copyLogsStatus;

    private async Task CopyAllLogs()
    {
        if (_isCopyingLogs)
        {
            return;
        }

        _isCopyingLogs = true;
        _copyLogsStatus = null;
        StateHasChanged();

        try
        {
            List<LogEvent> logs = LogService.GetLogsFor(_activeTab)
                .Where(log => string.IsNullOrEmpty(log.Level) || _selectedLevels.Contains(log.Level))
                .ToList();
            string text = string.Join('\n', logs.Select(log =>
                $"[{FormatTimestamp(log.Timestamp)}] [{GetShortLevel(log.Level)}] {log.RenderedMessage}"));

            await JS.InvokeVoidAsync("copyLogsToClipboard", text);
            _copyLogsStatus = $"Copied {logs.Count} lines to clipboard";
        }
        catch (Exception ex)
        {
            Log.Warning(ex, "Copying the live logs of {Tab} to the clipboard failed", _activeTab);
            _copyLogsStatus = "Copy failed — see server logs";
        }
        finally
        {
            _isCopyingLogs = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string GetShortLevel(string? level)
        => level switch
        {
            "Verbose" => "VRB",
            "Debug" => "DBG",
            "Information" => "INF",
            "Warning" => "WRN",
            "Error" => "ERR",
            "Fatal" => "FTL",
            _ => level?.Length >= 3 ? level.Substring(0, 3).ToUpperInvariant() : "UNK"
        };

    private string GetLogLevelClass(string? level)
        => level switch
        {
            "Verbose" => "log-vrb",
            "Debug" => "log-dbg",
            "Information" => "log-inf",
            "Warning" => "log-wrn",
            "Error" => "log-err",
            "Fatal" => "log-ftl",
            _ => ""
        };
}
