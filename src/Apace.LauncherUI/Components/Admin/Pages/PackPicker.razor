@namespace Apace.LauncherUI.Components.Admin.Pages
@using Apace.LauncherUI.Services

@* Searchable picker for thematic packs (marketplace theme tags) — a candidate
   list under a search box plus removable chips for the selection. Far more
   usable than hundreds of stacked checkboxes (the marketplace carries ~280
   distinct theme tags). Stale entries (dropped by a re-sync, or legacy
   skin-pack uuids from before the theme model) stay listed as warning chips
   under their raw id so they can still be removed. *@

<div class="pack-picker">
    <input class="form-control form-control-sm" type="search" placeholder="@Placeholder"
           value="@_query" @oninput="@(e => _query = (string?)e.Value ?? "")" />
    <div class="list-group mt-1 border rounded overflow-auto" style="max-height: 240px;">
        @if (Packs.Count == 0)
        {
            <div class="list-group-item py-1 small text-muted">No thematic packs indexed yet — run the live persona catalog sync first.</div>
        }
        else if (!Matches.Any())
        {
            <div class="list-group-item py-1 small text-muted">No packs match "@_query".</div>
        }
        @foreach (var pack in Matches)
        {
            bool selected = Selected.Contains(pack.Tag);
            <button type="button" class="list-group-item list-group-item-action py-1 small d-flex justify-content-between align-items-center @(selected ? "active" : "")"
                    @onclick="@(async () => await ToggleAsync(pack.Tag))">
                <span>@pack.Title <span class="text-muted small ms-1">@pack.Types</span></span>
                <span class="small @(selected ? "" : "text-muted")">
                    @(selected ? "✓ selected" : $"+ add ({pack.PieceCount} piece{(pack.PieceCount == 1 ? "" : "s")})")
                </span>
            </button>
        }
    </div>
    <div class="mt-2">
        @if (!Selected.Any())
        {
            <span class="text-muted small">@EmptyHint</span>
        }
        @foreach (string tag in Selected.OrderBy(Label, StringComparer.OrdinalIgnoreCase))
        {
            <span class="badge @(Known(tag) ? "text-bg-secondary" : "text-bg-warning") me-1 mb-1 fw-normal">
                @Label(tag)
                <a href="#" class="ms-1 text-decoration-none" @onclick="@(async () => await ToggleAsync(tag))" @onclick:preventDefault="true">×</a>
            </span>
        }
    </div>
</div>

@code {
    [Parameter]
    public string PickerId { get; set; } = "packs";

    [Parameter]
    public string Placeholder { get; set; } = "Search packs by name…";

    [Parameter]
    public string EmptyHint { get; set; } = "Nothing selected.";

    [Parameter]
    public HashSet<string> Selected { get; set; } = [];

    [Parameter]
    public EventCallback<HashSet<string>> SelectedChanged { get; set; }

    [Parameter]
    public List<PersonaPackIndex.ThemePackRow> Packs { get; set; } = [];

    private const int MatchCap = 10;

    private string _query = string.Empty;

    private IEnumerable<PersonaPackIndex.ThemePackRow> Matches
    {
        get
        {
            string filter = _query.Trim();
            var rows = filter.Length == 0
                ? Packs
                : Packs.Where(row => row.Title.Contains(filter, StringComparison.OrdinalIgnoreCase)
                    || row.Tag.Contains(filter, StringComparison.OrdinalIgnoreCase));
            return rows.OrderBy(row => row.Title, StringComparer.OrdinalIgnoreCase).Take(MatchCap);
        }
    }

    private bool Known(string tag)
        => Packs.Any(row => row.Tag.Equals(tag, StringComparison.OrdinalIgnoreCase));

    private string Label(string tag)
        => Packs.FirstOrDefault(row => row.Tag.Equals(tag, StringComparison.OrdinalIgnoreCase)) is { } match
            ? $"{match.Title} ({match.PieceCount} piece{(match.PieceCount == 1 ? "" : "s")})"
            : $"{tag} (no longer in the index)";

    private async Task ToggleAsync(string tag)
    {
        if (!Selected.Remove(tag))
        {
            Selected.Add(tag);
        }

        await SelectedChanged.InvokeAsync(Selected);
    }
}
