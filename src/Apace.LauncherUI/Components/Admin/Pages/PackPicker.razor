@namespace Apace.LauncherUI.Components.Admin.Pages
@using Apace.LauncherUI.Services

@* Searchable picker for packs — the marketplace's thematic packs (theme tags)
   plus the classic skin packs (selected by pack uuid). A candidate list under a
   search box plus removable chips for the selection. Far more usable than
   hundreds of stacked checkboxes (the marketplace carries ~280 distinct theme
   tags). The candidate list is virtualized: the full sorted index (~8K rows) is
   materialized once per query/index change and rendered through <Virtualize>,
   so every pack is reachable by scrolling instead of only a capped top slice.
   Stale entries (dropped by a re-sync, or legacy skin-pack uuids that
   are no longer in the index) stay listed as warning chips under their raw id
   so they can still be removed. The chip remove control is a real button, not
   an anchor: a href="#" click resolves against the base href and navigates to
   the panel home before the circuit's preventDefault applies. *@

<div class="pack-picker">
    <input class="form-control form-control-sm" type="search" placeholder="@Placeholder"
           value="@_query" @oninput="@(e => { _query = (string?)e.Value ?? ""; RefreshMatches(); })" />
    <div class="list-group mt-1 border rounded overflow-auto" style="max-height: 480px;">
        @if (Packs.Count == 0)
        {
            <div class="list-group-item py-1 small text-muted">No packs indexed yet — run the live persona catalog sync first.</div>
        }
        else if (_matches.Count == 0)
        {
            <div class="list-group-item py-1 small text-muted">No packs match "@_query".</div>
        }
        else
        {
            <Virtualize Items="@_matches" ItemSize="32" OverscanCount="10" Context="pack">
                @{
                    bool selected = Selected.Contains(pack.Tag);
                }
                <button type="button" class="list-group-item list-group-item-action py-1 small d-flex justify-content-between align-items-center @(selected ? "active" : "")"
                        @onclick="@(async () => await ToggleAsync(pack.Tag))">
                    <span>
                        @pack.Title
                        @if (pack.IsSkinPack)
                        {
                            <span class="badge text-bg-info fw-normal ms-1">classic</span>
                        }
                        <span class="text-muted small ms-1">@pack.Types</span>
                    </span>
                    <span class="small @(selected ? "" : "text-muted")">
                        @(selected ? "✓ selected" : $"+ add ({pack.PieceCount} {CountNoun(pack)})")
                    </span>
                </button>
            </Virtualize>
        }
    </div>
    <div class="mt-2">
        @if (!Selected.Any())
        {
            <span class="text-muted small">@EmptyHint</span>
        }
        @foreach (string tag in Selected.OrderBy(Label, StringComparer.OrdinalIgnoreCase))
        {
            <span class="badge @(Known(tag) ? "text-bg-secondary" : "text-bg-warning") me-1 mb-1 fw-normal">
                @Label(tag)
                <button type="button" class="border-0 bg-transparent p-0 ms-1"
                        style="font: inherit; line-height: 1; color: inherit; cursor: pointer;"
                        @onclick="@(() => ToggleAsync(tag))" aria-label="Remove">×</button>
            </span>
        }
    </div>
</div>

@code {
    [Parameter]
    public string PickerId { get; set; } = "packs";

    [Parameter]
    public string Placeholder { get; set; } = "Search packs by name…";

    [Parameter]
    public string EmptyHint { get; set; } = "Nothing selected.";

    [Parameter]
    public HashSet<string> Selected { get; set; } = [];

    [Parameter]
    public EventCallback<HashSet<string>> SelectedChanged { get; set; }

    [Parameter]
    public List<PersonaPackIndex.ThemePackRow> Packs { get; set; } = [];

    private string _query = string.Empty;

    // The full candidate list, materialized and cached: Virtualize needs a
    // countable list, and lazily re-sorting the ~8K-row index on every render
    // would thrash. It is recomputed only when the query changes (the search
    // input handler) or when the parent replaces the index (OnParametersSet,
    // by reference — selection toggles re-set Selected without re-sorting).
    private List<PersonaPackIndex.ThemePackRow> _matches = [];
    private List<PersonaPackIndex.ThemePackRow> _sourcePacks = [];

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_sourcePacks, Packs))
        {
            _sourcePacks = Packs;
            RefreshMatches();
        }
    }

    private void RefreshMatches()
    {
        string filter = _query.Trim();
        var rows = filter.Length == 0
            ? Packs
            : Packs.Where(row => row.Title.Contains(filter, StringComparison.OrdinalIgnoreCase)
                || row.Tag.Contains(filter, StringComparison.OrdinalIgnoreCase));
        _matches = rows.OrderBy(row => row.Title, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private bool Known(string tag)
        => Packs.Any(row => row.Tag.Equals(tag, StringComparison.OrdinalIgnoreCase));

    private string Label(string tag)
        => Packs.FirstOrDefault(row => row.Tag.Equals(tag, StringComparison.OrdinalIgnoreCase)) is { } match
            ? $"{match.Title} ({match.PieceCount} {CountNoun(match)})"
            : $"{tag} (no longer in the index)";

    // "piece(s)" for thematic packs, "skin(s)" for classic skin packs.
    private static string CountNoun(PersonaPackIndex.ThemePackRow row)
        => row.IsSkinPack ? $"skin{(row.PieceCount == 1 ? "" : "s")}" : $"piece{(row.PieceCount == 1 ? "" : "s")}";

    private async Task ToggleAsync(string tag)
    {
        if (!Selected.Remove(tag))
        {
            Selected.Add(tag);
        }

        await SelectedChanged.InvokeAsync(Selected);
    }
}
