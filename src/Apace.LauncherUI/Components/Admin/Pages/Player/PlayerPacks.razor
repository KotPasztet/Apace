@page "/Admin/Players/{PlayerId}/Packs"
@using Microsoft.AspNetCore.Authorization
@using Serilog
@using Apace.DB
@using Apace.DB.Models.Player
@using Apace.LauncherUI.Services
@using Apace.LauncherUI.Utils
@attribute [Authorize(Policy = Permissions.ManagePlayers)]
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Player Skin Packs - Apace</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <a href="/Admin/Players" class="btn btn-link p-0 mb-2">
        ← Back to Players
    </a>
    <div class="d-flex align-items-baseline gap-2">
        <div class="section-title mb-0" style="border-bottom: none; padding-bottom: 0;">
            <img class="nav-icon" src="/images/shop_icon.png" alt="" /> Skin Packs
        </div>
    </div>
    <div class="text-end">
        <button class="btn btn-sm btn-outline-primary" @onclick="SyncNowAsync" disabled="@_syncing">
            <i class="bi bi-arrow-repeat me-1"></i>@(_syncing ? "Syncing..." : "Sync now")
        </button>
        <div class="text-muted small mt-1">full walk ≈ several minutes — last sync: @LastSyncText</div>
        @if (_syncError is not null)
        {
            <div class="text-danger small mt-1">@_syncError</div>
        }
    </div>
</div>
<div class="d-flex align-items-baseline gap-2 mb-3">
    <h2 class="mb-0" style="font-size: 1.25rem;">
        Skin packs for @(string.IsNullOrEmpty(_username) ? $"player {PlayerId}" : $"{_username} (ID: {PlayerId})")
    </h2>
</div>

<PlayerTabs PlayerId="@PlayerId" Active="packs" />

@if (_message is not null)
{
    <div class="alert alert-info py-2 px-3">@_message</div>
}

<div class="card mb-4">
    <div class="card-header">Granted packs (extra packs beyond the panel defaults)</div>
    <div class="card-body">
        <p class="text-muted small mb-3">@EffectiveSummary
            Global defaults are managed on the <a href="/Admin/PersonaPacks">Marketplace Management</a> page.</p>

        @if (_packSummary is not null)
        {
            <p class="text-muted small">@_packSummary</p>
        }
        <PackPicker PickerId="grant" Packs="@_packs" Selected="@_grants"
                    SelectedChanged="@(v => { _grants = v; StateHasChanged(); })"
                    EmptyHint="Nothing granted beyond the panel defaults." />

        <button class="btn btn-sm btn-outline-primary mt-3" @onclick="SaveGrantsAsync" disabled="@_saving">
            @if (_saving)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
            Save grants
        </button>
    </div>
</div>

@code {
    [Parameter]
    public string PlayerId { get; set; } = string.Empty;

    private string? _username;
    private List<PersonaPackIndex.ThemePackRow> _packs = [];
    private string? _packSummary;
    private HashSet<string> _grants = [];
    private string? _message;
    private bool _saving;
    private bool _syncing;
    private string? _syncError;
    private EarthDB? _earthDB;

    private string LastSyncText => LivePersonaCatalogSync.GetLastVolumeSync()?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "never";

    // Matches the ApiServer's auto-gating (PersonaPackGate.AllowedPackUuidsAsync):
    // the allowed set is the panel defaults ∪ this player's grants — an empty
    // set gates the whole live marketplace off (0 marketplace cosmetics, the
    // built-in default skins still serve), a non-empty set enforces filtering.
    // The legacy "pack gating" toggle is gone; no flag is read anymore.
    private string EffectiveSummary
    {
        get
        {
            int limit = Settings.Instance.PersonaCategoryLimit ?? PersonaPackIndex.DefaultCategoryLimit;
            var defaults = Settings.Instance.PersonaDefaultPacks ?? [];
            int granted = _grants.Count(pack => !defaults.Contains(pack, StringComparer.OrdinalIgnoreCase));
            if (defaults.Count == 0 && _grants.Count == 0)
            {
                return $"Nothing configured — this player gets 0 marketplace cosmetics; the built-in default skins still serve. "
                    + "Grant packs below to unlock more: with at least one pack selected, the server serves those packs "
                    + "(thematic packs by their marketplace tag, classic skin packs by their pack uuid) plus the tagless base pieces. "
                    + $"The category-group limit still applies: up to {limit} piece(s) per dressing-room category group "
                    + "(e.g. hoodies and outerwear count together) — the server enforces it again when profiles are saved.";
            }

            return $"Auto-gating: this player sees the panel defaults ({defaults.Count} pack(s)) plus {granted} extra pack(s) — thematic packs "
                + "by their marketplace tag, classic skin packs (\"Minecraft adult skins\" and friends) by their pack uuid; base pieces without "
                + "a theme tag serve regardless. The category-group limit applies even with pack filtering on: "
                + $"up to {limit} piece(s) per dressing-room category group (e.g. hoodies and outerwear count together) — "
                + "the server enforces it again when profiles are saved.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        (_packs, _packSummary) = PersonaPackIndex.ReadThemePacks();
        try
        {
            using var liveDb = DataUtils.OpenLiveDB(Settings.Instance);
            if (liveDb is not null)
            {
                _username = await DataUtils.GetUsername(PlayerId, liveDb);
            }

            _earthDB = EarthDB.Open(Settings.Instance.EarthDatabaseConnectionString ?? "");
            EarthDB.Results results = await new EarthDB.Query(false)
                .Get("personaPacks", PlayerId, typeof(PersonaPackGrants))
                .ExecuteAsync(_earthDB, default);
            _grants = [.. results.Get<PersonaPackGrants>("personaPacks")?.Packs ?? []];
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to load persona pack grants for player '{PlayerId}'", PlayerId);
            _message = $"Loading the grants failed: {ex.Message}";
        }
    }

    // Same pattern as the Marketplace Management page's "Sync now": run the live
    // catalog sync inline, then re-read the pack index so the picker shows the
    // fresh packs. The walk takes several minutes; the button stays disabled
    // (and a concurrent sync elsewhere is a no-op) until it finishes.
    private async Task SyncNowAsync()
    {
        if (LivePersonaCatalogSync.IsSyncing)
        {
            return;
        }

        _syncing = true;
        _syncError = null;
        try
        {
            bool ok = await LivePersonaCatalogSync.SyncNowAsync(Log.Logger, CancellationToken.None);
            _syncError = ok ? null : (LivePersonaCatalogSync.LastError ?? "sync failed");
        }
        finally
        {
            _syncing = false;
            (_packs, _packSummary) = PersonaPackIndex.ReadThemePacks();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveGrantsAsync()
    {
        if (_earthDB is null)
        {
            return;
        }

        _saving = true;
        _message = null;
        try
        {
            await new EarthDB.Query(true)
                .Update("personaPacks", PlayerId, new PersonaPackGrants { Packs = [.. _grants] })
                .ExecuteAsync(_earthDB, default);
            _message = "Grants saved — the ApiServer applies them within ~30 seconds, once the dressing room reloads.";
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to save persona pack grants for player '{PlayerId}'", PlayerId);
            _message = $"Saving the grants failed: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    public void Dispose()
    {
        _earthDB?.Dispose();
    }
}
